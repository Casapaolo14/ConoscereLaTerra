<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/USS/Main.uss?fileID=7433441132597879392&amp;guid=79c87d3eb0107d344b00fd0e4fca75ce&amp;type=3#Main" />
    <ui:VisualElement name="BackgroundContainer" style="flex-grow: 1; background-image: none; -unity-background-scale-mode: stretch-to-fill; background-color: rgb(0, 0, 0);">
        <ui:VisualElement name="ButtonArea" style="flex-grow: 1; align-items: center; flex-wrap: wrap;">
            <ui:VisualElement name="LeftHalf" style="flex-grow: 1; width: 50%; align-items: auto; align-self: flex-start; height: 100%; justify-content: center;">
                <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; width: 50%; height: auto; align-items: stretch; justify-content: space-around; min-height: 60%; max-height: 60%; align-self: center;">
                    <ui:Button text="INIZIA" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Inizia" class="button" />
                    <ui:Button text="IMPOSTAZIONI" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Impostazioni" class="button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="RightHalf" style="flex-grow: 1; left: auto; width: 50%; align-items: auto; align-self: flex-end; height: 100%; justify-content: center;">
                <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; width: 50%; height: auto; align-items: stretch; justify-content: space-around; min-height: 60%; max-height: 60%; align-self: center;">
                    <ui:Button text="INIZIA" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Inizia" class="button" />
                    <ui:Button text="IMPOSTAZIONI" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Impostazioni" class="button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
